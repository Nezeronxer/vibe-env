{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nightshift",
  "version": "1.0.1",
  "identifier": "dev.nightshift.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Nightshift", "width": 960, "height": 680, "dragDropEnabled": true, "transparent": true }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage",
      "nsis",
      "msi"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Hand work to coding agents and stay away until they call you",
    "longDescription": "Desktop app that runs your coding-agent CLIs (Claude Code, Codex, Gemini CLI, opencode, Cursor, Qwen Code or your own command) on separate git copies, checks the result with tests and an independent reviewer, and merges it - you are called only when a human decision is needed.",
    "license": "MIT",
    "copyright": "Copyright (c) 2026 Nezeronxer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "dmg": {
        "background": "installer/dmg-background.tiff",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 190
        }
      }
    },
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Russian", "English"], "displayLanguageSelector": false },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    },
    "linux": {
      "deb": {
        "section": "devel",
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "git"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "libappindicator-gtk3",
          "git"
        ]
      }
    }
  }
}
